# .env-gog.example — template for gogcli headless/cron use
# Copy to .env-gog, fill in values, then `chmod 600 .env-gog`
# nova-gog-setup auto-loads this file

# ─── Required for cron use ─────────────────────────────────
# Keyring backend for headless agents (no GUI keychain access)
GOG_KEYRING_BACKEND=file
GOG_KEYRING_PASSWORD=replace-with-strong-passphrase

# ─── Optional: account shortcuts ──────────────────────────
# Default account when --account is not passed
GOG_ACCOUNT=you@gmail.com

# ─── Optional: token storage root ─────────────────────────
# Where gog stores config + tokens. Default:
#   ~/Library/Application Support/gogcli (macOS)
#   ~/.config/gogcli (Linux)
# GOG_HOME=/custom/path

# ─── Optional: client alias ───────────────────────────────
# Named OAuth client. Default uses the first registered client.
# GOG_CLIENT=my-desktop-client
