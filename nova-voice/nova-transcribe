#!/bin/zsh
set -e
IN="$1"
TMP="/tmp/nova-transcribe-$$.wav"
/opt/homebrew/bin/ffmpeg -y -hide_banner -loglevel error -i "$IN" -ar 16000 -ac 1 "$TMP"
/opt/homebrew/bin/whisper-cli \
  -m /Users/nova/.openclaw/workspace/models/whisper-cpp/ggml-small.bin \
  -l th -nt -np "$TMP" 2>/dev/null
rm -f "$TMP"
